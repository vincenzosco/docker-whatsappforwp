# docker-whatsappforwp configuration. Copy it and edit:
#
#   cp .env.example .env
#
# Every value has a default inside the image; you only need to set the ones you
# want to change.

# ── The app ─────────────────────────────────────────────────────────────────
# TCP port the WP8.1 app connects to.
BRIDGE_PORT=8585

# Must match the "Passphrase" constant in WhatsappApp/Services/CryptoHelper.cs.
# It is compiled into the app, so leave this alone unless you rebuilt the app
# with a different passphrase: a mismatch shows up as "Message decryption error".
BRIDGE_KEY=WhatsAppCommunityWP8-2026
# "off" disables encryption (plaintext protocol, not recommended).
BRIDGE_ENCRYPTION=on

# ── Automatic discovery ─────────────────────────────────────────────────────
# The adapter announces itself over UDP so the app finds it without you typing an
# address. Needs host networking to cross into the LAN (docker-compose.host.yaml).
DISCOVERY_ENABLED=on
DISCOVERY_PORT=8587
# Name shown in the app's server list; empty means the host name.
DISCOVERY_NAME=

# ── GOWA (inside the same container) ────────────────────────────────────────
# The address the adapter uses. Loopback, because GOWA and the adapter are one
# container.
GOWA_URL=http://127.0.0.1:3000
GOWA_PORT=3000
# Leave 127.0.0.1 unless you really want the GOWA web UI reachable from the LAN,
# and set GOWA_USER/GOWA_PASS if you do: that API can send messages as your
# account.
GOWA_HOST=127.0.0.1
GOWA_UI=false
GOWA_USER=
GOWA_PASS=
# A specific GOWA device id (multi-device); empty means the default device.
GOWA_DEVICE_ID=

# ── Webhook (GOWA -> adapter, same container) ───────────────────────────────
WEBHOOK_PORT=8586
WEBHOOK_PATH=/webhook
WEBHOOK_PUBLIC_URL=http://127.0.0.1:8586/webhook
# Must match --webhook-secret on GOWA (default: "secret").
WEBHOOK_SECRET=

# ── Miscellaneous ───────────────────────────────────────────────────────────
# How often the adapter polls WhatsApp's status, in milliseconds.
POLL_INTERVAL_MS=5000
