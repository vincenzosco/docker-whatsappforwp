# docker-whatsappforwp configuration. Copy it and edit:
#
#   cp .env.example .env
#
# Every value has a default inside the image; you only need to set the ones you
# want to change.

# ── The app ─────────────────────────────────────────────────────────────────
# TCP port the WP8.1 app connects to.
BRIDGE_PORT=8585

# Must match the "Passphrase" constant in WhatsappApp/Services/CryptoHelper.cs.
# It is compiled into the app, so leave this alone unless you rebuilt the app
# with a different passphrase: a mismatch shows up as "Message decryption error".
BRIDGE_KEY=WhatsAppCommunityWP8-2026
# "off" disables encryption (plaintext protocol, not recommended).
BRIDGE_ENCRYPTION=on

# ── Automatic discovery ─────────────────────────────────────────────────────
# The adapter announces itself over UDP so the app finds it without you typing an
# address. Needs host networking to cross into the LAN (docker-compose.host.yaml).
DISCOVERY_ENABLED=on
DISCOVERY_PORT=8587
# Name shown in the app's server list; empty means the host name.
DISCOVERY_NAME=

# ── GOWA (inside the same container) ────────────────────────────────────────
# The address the adapter uses. Loopback, because GOWA and the adapter are one
# container.
GOWA_URL=http://127.0.0.1:3000
GOWA_PORT=3000
# Leave 127.0.0.1 unless you really want the GOWA web UI reachable from the LAN,
# and set GOWA_USER/GOWA_PASS if you do: that API can send messages as your
# account.
GOWA_HOST=127.0.0.1
GOWA_UI=false
GOWA_USER=
GOWA_PASS=
# A specific GOWA device id (multi-device); empty means the default device.
GOWA_DEVICE_ID=

# ── Webhook (GOWA -> adapter, same container) ───────────────────────────────
WEBHOOK_PORT=8586
WEBHOOK_PATH=/webhook
WEBHOOK_PUBLIC_URL=http://127.0.0.1:8586/webhook
# Must match --webhook-secret on GOWA (default: "secret").
WEBHOOK_SECRET=

# ── WhatsApp data ───────────────────────────────────────────────────────────
# How many conversations the app's chat list returns.
CHATS_LIMIT=25
# Fetch each chat's profile picture: one request per chat, groups included.
CHATS_AVATARS=on
# How many messages opening a chat loads.
MESSAGES_LIMIT=50
# How many recent chats the call-history scan reads, how many messages per chat,
# and how many call records it sends. The scan makes one request per chat, so
# this is what it costs in time.
CALLS_CHAT_LIMIT=25
CALLS_MESSAGES_PER_CHAT=100
CALLS_LIMIT=50

# ── Voice notes (ffmpeg) ────────────────────────────────────────────────────
# ffmpeg is installed in the image. A received voice note is Ogg/Opus and
# WP8.1 has no Opus decoder, so the adapter converts it to a small mono MP3.
# "off" forwards the original bytes instead, which the phone cannot play.
FFMPEG_ENABLED=on
# Only if you replaced the ffmpeg in the image with a build kept elsewhere.
FFMPEG_PATH=

# ── Miscellaneous ───────────────────────────────────────────────────────────

# ── Shared service ──────────────────────────────────────────────────────────
# Require a token on the first frame. Off for a private instance; turn it on for
# a shared one, and that is the whole job.
AUTH_REQUIRED=off
# A phone that connects without a token is given one on the spot, so nothing has
# to be typed into the app. Set it to off to close the service and hand the
# tokens out by hand (docker exec ... create-user.js).
AUTH_REGISTER=on
# Ceiling on the devices that can register themselves, so an open service cannot
# fill its disk one handshake at a time.
AUTH_MAX_USERS=50
# Where the users live. Empty keeps them in memory (private instance only);
# /data/users.json survives a restart like the WhatsApp session does.
USERS_FILE=/data/users.json
# How often the adapter polls WhatsApp's status, in milliseconds.
POLL_INTERVAL_MS=5000

# ── Tunnel (docker-compose.nas.yaml) ────────────────────────────────────────
# The tunnel service (only used with docker-compose.nas.yaml).
TUNNEL_SERVER=bore.pub
# The public port asked for first. bore.pub grants it when it is free, which is
# what keeps the address in the endpoint repository valid across restarts; when
# it is taken the service falls back to a random one and says so in its log.
# 0 means always random, which is what a shared tunnel used to be.
TUNNEL_PORT=41417

# ── Automatic endpoint publishing (docker-compose.nas.yaml) ─────────────────
# The tunnel asks for TUNNEL_PORT first, so the address normally does not
# change. When it does - somebody else had taken the port - the tunnel asks the
# GitHub CLI to put the new one in the endpoint repository, so the phone finds
# the service with no manual step.
ENDPOINT_AUTO_PUBLISH=on
# The repository the app reads its address from.
ENDPOINT_REPO=vincenzosco/whatsappforwp-endpoint
# A GitHub token that may write to ENDPOINT_REPO, used by gh inside the tunnel
# container. It is a credential: keep it out of git, and give it the smallest
# scope that works (a fine-grained token with "Contents: read and write" on this
# one repository). To reuse the login that `gh auth login` already made on this
# machine:
#
#   gh auth token
#
# Leave it empty to keep publishing manual: the tunnel still prints the command.
GH_TOKEN=
