# syntax=docker/dockerfile:1
#
# The tunnel to bore.pub, with a memory.
#
# It replaces the pinned `ekzhang/bore` image as the service that exposes the
# adapter. The binary is the same; what is added is a shell around it, because
# the released image is a static binary and cannot do the two things this
# deployment needs:
#
#  1. ask bore.pub for the same public port every time. The server grants it
#     when it is free, and the app's endpoint then survives a restart or a
#     reboot without anybody republishing it;
#  2. fall back to a random port when that port has been taken in the meantime,
#     instead of exiting and leaving the phone with an address that answers
#     nothing.
#
# It also carries the GitHub CLI, so that the address it was given can be put in
# the endpoint repository by the container itself. That is what makes the whole
# thing unattended: when the preferred port has been taken and the address
# changes, nobody has to notice and run publish.js. Without a GH_TOKEN nothing
# is published and the address simply stays manual, as before.
#
# Built and published by .github/workflows/image.yml as
# ghcr.io/vincenzosco/docker-whatsappforwp-tunnel.

ARG BORE_VERSION=0.6.0

FROM alpine:3.20

ARG BORE_VERSION
ARG TARGETARCH

LABEL org.opencontainers.image.title="whatsapp-for-wp8-tunnel" \
      org.opencontainers.image.description="bore.pub tunnel for the WP8.1 adapter, asking for a stable port" \
      org.opencontainers.image.source="https://github.com/vincenzosco/docker-whatsappforwp" \
      org.opencontainers.image.licenses="MIT"

# The release names its architectures x86_64/aarch64, the build names them
# amd64/arm64: the two are not the same string, and the wrong one is a 404.
RUN set -eux; \
    apk add --no-cache ca-certificates curl github-cli; \
    case "${TARGETARCH:-amd64}" in \
      amd64) arch="x86_64" ;; \
      arm64) arch="aarch64" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/bore.tar.gz \
      "https://github.com/ekzhang/bore/releases/download/v${BORE_VERSION}/bore-v${BORE_VERSION}-${arch}-unknown-linux-musl.tar.gz"; \
    tar -xzf /tmp/bore.tar.gz -C /usr/local/bin bore; \
    chmod +x /usr/local/bin/bore; \
    rm -f /tmp/bore.tar.gz; \
    bore --version

COPY docker/tunnel-entrypoint.sh /usr/local/bin/tunnel-entrypoint.sh
COPY docker/publish-endpoint.sh /usr/local/bin/publish-endpoint.sh
RUN chmod +x /usr/local/bin/tunnel-entrypoint.sh /usr/local/bin/publish-endpoint.sh

# TUNNEL_PORT is the port asked for first; 0 means "whatever the server has",
# which is the old behaviour and is used only when the preferred one is taken.
ENV BRIDGE_PORT=8585 \
    TUNNEL_SERVER=bore.pub \
    TUNNEL_PORT=0 \
    ENDPOINT_AUTO_PUBLISH=on \
    ENDPOINT_REPO=vincenzosco/whatsappforwp-endpoint

# Host networking: bore has to reach the adapter on the machine itself, and a
# bridge would put it on another network (see docker-compose.nas.yaml).
ENTRYPOINT ["/usr/local/bin/tunnel-entrypoint.sh"]
